# SMIT portal: copy to .env.local and supply server-side credentials.
# Standard Atlas mongodb+srv URIs work where SRV DNS is available.
# If local SRV lookup fails, use Atlas's expanded mongodb:// host list with TLS.
MONGODB_URI=
AUTH_JWT_SECRET=
# Next.js forwards /api requests to this server-only origin.
NEST_BACKEND_URL=http://127.0.0.1:4000
# Nest listens here locally; deployment platform supplies PORT in production.
PORT=4000

# Primary model selected from project-specific evaluation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional second key from the same provider.
GEMINI_API_KEY_2=

# Fallback with automatic key failover.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# Optional voice synthesis; browser speech remains available without it.
ELEVENLABS_API_KEY=

# Fast first response; Gemini is fallback. Set gemini to reverse the order.
AI_PRIMARY_PROVIDER=groq
