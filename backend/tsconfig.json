{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "incremental": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "..",
    "outDir": "./dist",
    "baseUrl": "..",
    "plugins": []
  },
  "tsc-alias": { "resolveFullPaths": true, "resolveFullExtension": ".js" },
  "include": ["./**/*.ts"],
  "exclude": ["dist", "../node_modules"]
}
