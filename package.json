{
  "name": "smit-donations",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "multer": "2.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backend:build": "tsc -p backend/tsconfig.json && tsc-alias -p backend/tsconfig.json && node scripts/mark-backend-esm.mjs",
    "backend:start": "node --env-file=.env.local backend/dist/backend/main.js",
    "backend:package": "npm run backend:build && node scripts/package-backend.mjs",
    "lint": "eslint",
    "ai:benchmark": "tsx --env-file=.env.local scripts/benchmark-models.ts",
    "test:ai-charts": "tsx --env-file=.env.local scripts/test-ai-charts.ts",
    "test:agent-live": "tsx --env-file=.env.local scripts/test-agent-live.ts",
    "auth:seed": "tsx scripts/auth-seed.ts",
    "seed:test-admin": "tsx scripts/seed-test-admin.ts",
    "secure:test-accounts": "tsx --env-file=.env.local scripts/secure-test-accounts.ts",
    "db:indexes": "tsx --env-file=.env.local scripts/ensure-indexes.ts",
    "verify:data": "tsx --env-file=.env.local scripts/verify-data.ts",
    "verify:agent-data": "tsx --env-file=.env.local scripts/verify-agent-data.ts",
    "e2e": "tsx --env-file=.env.local scripts/e2e-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "mongodb": "^7.5.0",
    "next": "^16.3.5",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
